; Engine configuration file.
; Spellfall — original mobile arena brawler.
; Generated for Godot 4.7. See docs/ARCHITECTURE.md for why these values are set.

config_version=5

[application]

config/name="Spellfall"
config/description="Original mobile arena brawler. Knock your opponent out of the ring."
run/main_scene="res://core/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

; Landscape, mobile-first. 1280x720 is the design resolution every UI value is authored against.
window/size/viewport_width=1280
window/size/viewport_height=720
; "expand" (not "keep") so wider phones show more world instead of black bars.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 is SCREEN_SENSOR_LANDSCAPE. It was 1 - which is SCREEN_PORTRAIT - for four sessions,
; with a comment above it saying "Landscape". Every desktop run looked right because this
; setting only applies to a handheld, so the first phone build was the first time anyone
; could see it, and it shipped a portrait game. SENSOR rather than a fixed landscape so the
; phone can be held either way up.
window/handheld/orientation=4

