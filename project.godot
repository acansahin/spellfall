[input_devices]

; OFF, and the reason is load-bearing. `DisplayServer.is_touchscreen_available()` reports
; TRUE whenever this is on, so with emulation enabled there is no way left to ask "is a finger
; driving this?" - a desktop and a phone give the same answer. That is fine while the only
; controls are thumb controls and wrong the moment a build has to serve both: a person at a
; keyboard got a thumbstick and four thumb buttons drawn over their game.
;
; Nothing needed it. The suites that drive the touch controls inject InputEventScreenTouch
; directly (see main.gd `_emit_touch`), never through a mouse, and the loadout screen reads
; mouse buttons as well as touches. `--touch-ui:on` is how a desktop run asks to see the
; thumb controls now.
;
; `emulate_mouse_from_touch` is a DIFFERENT setting, is left at its default of on, and is what
; lets a finger press the menu on a phone.
pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="projectiles"
3d_physics/layer_4="killzone"

[physics]

; Fixed 60Hz simulation. Gameplay must never depend on rendered framerate — this is also
; the tick rate a future server-authoritative build will run at.
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Required for Android export even before textures exist — omitting it aborts the export.
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
anti_aliasing/quality/msaa_3d=1
