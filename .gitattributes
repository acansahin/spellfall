# Normalise to LF in the repository. Godot writes LF, and without this a Windows checkout
# produces whole-file diffs made of nothing but line endings — the sibling tower-defense
# repo carries 183 such files. Keep this before the first commit.
* text=auto eol=lf

# Binary assets must never be line-ended.
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
