[sub_resource type="Resource" id="Column_strike"]
script = ExtResource("2_column")
title = "STRIKE"
subtitle = "Your second way to land one"
spells = Array[ExtResource("3_ability")]([ExtResource("5_force_wave"), ExtResource("6_arc_lance"), ExtResource("7_seeker"), ExtResource("8_loopshot"), ExtResource("9_meteor"), ExtResource("10_splitter"), ExtResource("11_fire_spray"), ExtResource("12_bouncer")])

[sub_resource type="Resource" id="Column_control"]
